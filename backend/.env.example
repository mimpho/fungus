# ── Base de datos ────────────────────────────────────────────────────────────
# Dev local (docker compose up -d):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fungus
# Supabase compartido — Connect → Session pooler (puerto 5432):
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<db-password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# ── Seguridad ────────────────────────────────────────────────────────────────
# openssl rand -hex 32
SECRET_KEY=cambia-esto-en-produccion

# ── Auth (JWT + Google OAuth) ────────────────────────────────────────────────
# Usa los mismos valores que en Render para que los tokens existentes y el login con Google funcionen en local
JWT_SECRET_KEY=cambia-esto-en-produccion
JWT_ALGORITHM=HS256
GOOGLE_CLIENT_ID=

# ── Email (Resend) — opcional, solo para enviar emails de verificación ───────
RESEND_API_KEY=
FRONTEND_URL=http://localhost:5173

# ── APIs meteorológicas (P1 - opcionales, fallback a Open-Meteo si no están) ─
METEOCAT_API_KEY=
AEMET_API_KEY=

# ── Entorno ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | production
# Apply Alembic migrations on API startup. Unset = only when ENVIRONMENT=production.
# Keep it off locally: this .env usually points at the shared production DB.
# RUN_MIGRATIONS_ON_STARTUP=false
LOG_LEVEL=INFO

# ── CORS (dominios permitidos, separados por coma) ───────────────────────────
CORS_ORIGINS=http://localhost:5173,https://fungus.vercel.app

# ── Ingesta ──────────────────────────────────────────────────────────────────
INGEST_CRON_HOUR=0               # hora UTC del cron diario (00:05 UTC, justo tras renovarse la cuota de Open-Meteo)
INGEST_CRON_MINUTE=5             # minuto de la ingesta diaria
CELL_REFRESH_CRON_MINUTE=40      # minuto del refresco de celdas (misma hora que la ingesta)
INGEST_MAX_CONCURRENCY=6         # llamadas paralelas a APIs externas

# Ops alerts — after the daily ingest, email the zones with no climate data in
# the last STALE_ZONE_DAYS days. Needs RESEND_API_KEY. Empty = no email.
ALERT_EMAIL=
STALE_ZONE_DAYS=2

# Current weather (weather_cache): refreshed every 3 h by a job. Rows older than
# WEATHER_MAX_AGE_HOURS are not served ("–" in the UI). WEATHER_DAILY_CALL_BUDGET
# caps Open-Meteo calls per UTC day for it (free limit 10,000/day, shared with
# the ingest and backfills).
WEATHER_MAX_AGE_HOURS=6
WEATHER_DAILY_CALL_BUDGET=3000

# Corner photos (Observatory): a PRIVATE Supabase Storage bucket, reached by REST with the
# service key. Never put the key in the front end or in git. Use a DEV bucket locally: the
# local .env points at production. Empty URL or key = photos off (uploads answer 503).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
CORNER_PHOTOS_BUCKET=corner-photos
# Abuse guards (0 = off): bytes per upload, decoded pixels, uploads and new corners per user and UTC day
CORNER_PHOTO_MAX_BYTES=15728640
CORNER_PHOTO_MAX_PIXELS=60000000
CORNER_PHOTO_UPLOADS_PER_USER_PER_DAY=30
OBSERVATORY_MAX_NEW_CORNERS_PER_USER_PER_DAY=50

# Class rasters (forest, soil) from a PRIVATE Supabase bucket, downloaded at start-up with the
# SUPABASE_URL / SUPABASE_SERVICE_KEY above. Empty = off: FOREST_RASTER_DIR / SUBSTRATE_RASTER_DIR
# are read as they are (local-data/ in development). Production sets the bucket name.
RASTERS_BUCKET=
# true = refuse to start if the download fails (default: start without them and retry)
RASTERS_REQUIRED=false
# Where they are downloaded; empty = <system temp dir>/fungus-rasters
RASTERS_CACHE_DIR=
