---
title: Mobile Navigation — Fungus Android v8.0 (expo-router v4)
---
flowchart TD
    Root["_layout.tsx\nRoot Layout\n(auth guard + fonts)"]

    Root -->|"token absent\nor expired"| AuthGroup
    Root -->|"token valid"| Tabs

    subgraph AuthGroup["auth/ (unauthenticated)"]
        Login["login.tsx\nLogin\n(email + password)"]
        Register["register.tsx\nRegister"]
        Login -->|"no account?"| Register
        Register -->|"already have one?"| Login
    end

    subgraph Tabs["(tabs)/ — 4 tabs"]
        Zones["index.tsx\nZonas\n(home — list view)"]
        Map["mapa.tsx\nMapa\n(MapLibre markers)"]
        Species["especies.tsx\nEspecies\n(catalogue)"]
        Profile["perfil.tsx\nPerfil\n(lang · auth)"]
    end

    subgraph Modals["Modals"]
        ZoneDetail["zona/id.tsx\nZone Detail\n(bottom sheet)\nConditions · Score"]
        SpeciesDetail["especie/id.tsx\nSpecies Detail\n(full-screen)\nGallery · Confusions"]
    end

    AuthGroup -->|"login success → JWT"| Tabs

    Zones -->|"tap zone card"| ZoneDetail
    Map -->|"tap marker"| ZoneDetail

    Species -->|"tap species"| SpeciesDetail
    ZoneDetail -->|"tap in-season species"| SpeciesDetail
    SpeciesDetail -->|"tap confusion species"| SpeciesDetail

    Profile -->|"not logged in\ntap login"| Login
    Profile -->|"logged in\ntap logout"| Login
